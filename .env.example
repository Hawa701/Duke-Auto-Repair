# Browser key: restrict it to your website domains in Google Cloud.
# Enable Maps JavaScript API and Places API (New). Billing must be enabled.
# Leave empty to use the supplied Google rating and review-count snapshot.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: a Google Place ID (not the numeric CID in a Maps URL).
# If empty, the app finds the listing by its exact name and address.
NEXT_PUBLIC_GOOGLE_PLACE_ID=
